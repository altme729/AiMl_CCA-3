from transformers import pipeline

# Initialize the Hugging Face sentiment-analysis pipeline
# Note: This will download the default model (distilbert) on the first run
sentiment_analyzer = pipeline("sentiment-analysis")

# Problem Statements (Expanded list as per assignment requirements)
problem_statements = [
    "The new AI integration in our banking app is incredibly fast and intuitive.",
    "I am extremely frustrated with the hidden fees in this transaction.",
    "The stock market remained stagnant today with no significant fluctuations.",
    "Customer service was unresponsive when I tried to report a fraudulent charge.",
    "I love how seamless the peer-to-peer payment feature is!"
]

print("--- Hugging Face Sentiment Monitor Results ---")
for statement in problem_statements:
    result = sentiment_analyzer(statement)[0]
    print(f"\nStatement: '{statement}'")
    print(f"Sentiment: {result['label']} (Confidence Score: {result['score']:.4f})")
