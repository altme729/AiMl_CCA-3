# Description: Traditional Programming Vs Machine Learning reading from .xlsx

import pandas as pd
from sklearn.tree import DecisionTreeClassifier

# Load the input data
print("Loading data from input_data.xlsx...")
try:
    df = pd.read_excel('input_data.xlsx')
except FileNotFoundError:
    print("Error: input_data.xlsx not found. Please run create_excel.py first.")
    exit()

# ---------------------------------------------------------
# APPROACH 1: Traditional Programming (Rule-Based)
# ---------------------------------------------------------
def traditional_logic(amount):
    # Explicitly programming the rule
    if amount > 1000:
        return 'High'
    else:
        return 'Low'

df['Trad_Prediction'] = df['Amount'].apply(traditional_logic)

# ---------------------------------------------------------
# APPROACH 2: Machine Learning (Data-Driven)
# ---------------------------------------------------------
# The model learns the rule from the data
X = df[['Amount']] 
y = df['Actual_Category']

# Initialize and train the model
model = DecisionTreeClassifier()
model.fit(X, y)

# Make predictions
df['ML_Prediction'] = model.predict(X)

print("\n--- Results Comparison ---")
print(df[['Amount', 'Actual_Category', 'Trad_Prediction', 'ML_Prediction']])
